# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this example is committed so the required keys are documented.

# Backend URL used in debug/development builds. The API's default port is
# 8493 (see ../cosmo-strike-dotnet-api/.env.example). Use your machine's LAN
# IP instead of 127.0.0.1 when testing on a physical device.
DEV_API_BACKEND_URL=http://127.0.0.1:8493

# Backend URL used in release/production builds.
PROD_API_BACKEND_URL=

# Google OAuth web client ID (used as serverClientId for Google Sign-In).
GOOGLE_WEB_CLIENT_ID=
